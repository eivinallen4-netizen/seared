import json
from pathlib import Path
from PIL import Image
manifest = Path('assets-src/food/manifest-b.json')
entries = json.loads(manifest.read_text(encoding='utf-8'))
for e in entries:
    with Image.open(e['file']) as im:
        assert im.mode == 'RGBA', (e['id'], im.mode)
        w, h = im.size
        assert w == h
        a = im.getchannel('A')
        corners = [a.getpixel(p) for p in [(0,0),(w-1,0),(0,h-1),(w-1,h-1)]]
        assert corners == [0]*4, (e['id'], corners)
        bbox = a.getbbox()
        margin = [bbox[0],bbox[1],w-bbox[2],h-bbox[3]]
        assert min(margin) > 0, (e['id'], bbox)
        e['notes'] += f' Pillow verified: {w}x{h} RGBA; all four corners fully transparent; alpha bbox {bbox}; margins left/top/right/bottom {margin} px. No background removal required.'
        print(e['id'], im.size, im.mode, 'margins', margin)
manifest.write_text(json.dumps(entries, indent=2) + '\\n', encoding='utf-8')
print('PASS: all 12 PNGs validated')
