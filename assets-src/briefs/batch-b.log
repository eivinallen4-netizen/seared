import json, shutil
from pathlib import Path
from PIL import Image
manifest=Path('assets-src/food/manifest-b.json')
entries=json.loads(manifest.read_text(encoding='utf-8'))
originals=Path('assets-src/food/originals')
originals.mkdir(exist_ok=True)
for e in entries:
    p=Path(e['file'])
    original=originals/p.name
    if original.exists():
        raise RuntimeError('Original already exists: '+str(original))
    shutil.copy2(p,original)
    with Image.open(p) as im:
        im.load()
        im.putalpha(im.getchannel('A').point(lambda x: 0 if x<=10 else x))
        im.save(p)
    with Image.open(p) as im:
        w,h=im.size
        assert im.mode=='RGBA' and w==h
        a=im.getchannel('A')
        assert all(a.getpixel(pt)==0 for pt in [(0,0),(w-1,0),(0,h-1),(w-1,h-1)])
        bbox=a.getbbox()
        margins=[bbox[0],bbox[1],w-bbox[2],h-bbox[3]]
        assert min(margins)>0, (e['id'],margins)
        e['notes']=f'Generated with built-in image_gen; visually reviewed. Removed near-invisible background alpha noise (alpha <= 10/255 set to zero); original retained at {original.as_posix()}. Pillow verified: {w}x{h} RGBA; four fully transparent corners; alpha bbox {bbox}; margins left/top/right/bottom {margins} px.'
        print(e['id'],'PASS',f'{w}x{h}',margins)
manifest.write_text(json.dumps(entries,indent=2)+'\\n',encoding='utf-8')
