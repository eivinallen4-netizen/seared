Validation found faint alpha specks outside the trays. I’ll remove those and retain the originals. The builder bases match visually, but their outlines differ by about 2 pixels; I’ll document that limit in the manifest.

exec
"C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
from PIL import Image
from pathlib import Path
import shutil, json
root=Path('assets-src/food')
originals=root/'originals'
originals.mkdir(exist_ok=True)
report={}
for p in sorted(root.glob('*.png')):
 shutil.copy2(p, originals/p.name)
 im=Image.open(p)
 assert im.mode=='RGBA', (p.name,im.mode)
 alpha=im.getchannel('A')
 alpha=alpha.point(lambda a: 0 if a<=8 else a)
 im.putalpha(alpha)
 im.save(p)
 w,h=im.size
 corners=[alpha.getpixel(pt) for pt in [(0,0),(w-1,0),(0,h-1),(w-1,h-1)]]
 bbox=alpha.getbbox()
 assert corners==[0,0,0,0], (p.name,corners)
 assert bbox and bbox[0]>0 and bbox[1]>0 and bbox[2]<w and bbox[3]<h, (p.name,bbox)
 assert w==h and w>=1024
 report[p.stem]={'size':[w,h],'mode':im.mode,'alpha_bbox':bbox,'margins':[bbox[0],bbox[1],w-bbox[2],h-bbox[3]],'corners':corners}
print(json.dumps(report,indent=2))
